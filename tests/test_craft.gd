extends SceneTree
const Parts = preload("res://scripts/parts.gd")
const Craft = preload("res://scripts/craft_model.gd")
const Flight = preload("res://scripts/flight_model.gd")
var failures: Array[String] = []
var count := 0

func check(condition: bool, message: String) -> void:
	count += 1
	if not condition: failures.append(message)

func _initialize() -> void:
	var bare := Craft.seed()
	Craft.add_part(bare,"capsule")
	check(Craft.valid(bare) and bare.stages.is_empty(), "Capsule alone has no parachute stage")
	Craft.add_part(bare,"parachute")
	check(bare.stages == [["deploy:capsule"]], "Installing parachute adds deployment action")
	Craft.remove_part(bare,"parachute")
	check(Craft.valid(bare) and bare.stages.is_empty(), "Removing parachute removes deployment action")
	var stale := bare.duplicate(true)
	stale.stages = [["deploy:capsule"]]
	var upgraded_bare := Craft.load_craft({"assembly":stale})
	check(upgraded_bare.parts.size() == 1 and upgraded_bare.stages.is_empty(), "Old phantom parachute action is cleaned without changing saved parts")
	var bare_flight := Flight.new()
	bare_flight.reset(Craft.project(bare,Parts.default_design()))
	bare_flight.state.status = "flying"
	bare_flight.state.position = Vector3(0,1000,0)
	bare_flight.state.velocity = Vector3(0,-10,0)
	check(bare_flight.deploy_chute() == "No parachute installed." and not bare_flight.telemetry().chute_safe, "Absent parachute cannot deploy through the shortcut")
	Craft.add_part(bare,"tank")
	Craft.add_part(bare,"sparrow")
	Craft.add_part(bare,"decoupler")
	check(bare.stages == [["ignite:engine"],["separate:decoupler"]], "Capsule separation follows ignition when no parachute exists")
	Craft.add_part(bare,"decoupler","engine")
	Craft.add_part(bare,"tank")
	Craft.add_part(bare,"kestrel")
	var lower_id: String = bare.parts[-1].id
	check(bare.stages == [["ignite:"+lower_id],["separate:engine_decoupler"],["ignite:engine"],["separate:decoupler"]], "Two-engine plan follows lower ignition, interstage separation, upper ignition and capsule separation")
	var labels := Parts.stage_plan(Craft.project(bare,Parts.default_design()))
	check(labels[0].contains("Kestrel") and labels[2].contains("Sparrow") and not str(labels).contains("parachute"), "Stage labels name each actual engine without a phantom parachute")
	Craft.add_part(bare,"separator")
	Craft.add_part(bare,"boosters")
	check(bare.stages[1] == ["ignite:boosters"] and bare.stages[0] == ["ignite:"+lower_id], "New booster ignition gets its own block")
	check(not Craft.project(bare,Parts.default_design()).booster_first, "Lower-engine ignition is not mistaken for booster-only launch")
	var shrouded := Craft.migrate(Parts.default_design())
	Craft.add_part(shrouded, "decoupler", "engine")
	check(Craft.valid(shrouded), "Engine-bottom decoupler coexists with capsule decoupler")
	var restored := Craft.load_craft(Craft.project(shrouded, Parts.default_design()))
	check(Craft.valid(restored) and restored.stages == shrouded.stages and restored.parts.any(func(part): return part.id == "engine_decoupler" and part.parent == "engine"), "Engine decoupler survives save and load")
	Craft.add_part(restored, "tank")
	check(Craft.valid(restored) and restored.parts.any(func(part): return part.id == "engine_decoupler" and part.parent == "engine"), "Adding a tank preserves the engine-bottom connection")
	check(restored.parts.any(func(part): return part.kind == "tank" and part.parent == "engine_decoupler"), "New fuel tank attaches beneath the engine decoupler")
	var lower_design := Craft.project(restored, Parts.default_design())
	check(is_equal_approx(Craft.engine_base(lower_design), 2.15), "Engine sits above the lower tank")
	var multistage := restored.duplicate(true)
	Craft.add_part(multistage, "titan")
	var multi_design := Craft.project(multistage, Parts.default_design())
	var engines := Craft.engines(multi_design)
	check(engines.size() == 2 and engines[0].kind == "sparrow" and engines[1].kind == "titan", "Second engine attaches without replacing upper engine")
	check(Craft.valid(multistage) and Craft.valid(Craft.load_craft(multi_design)), "Multiple engines and ignition actions survive save/load")
	check(is_equal_approx(Craft.engine_base(multi_design)-Craft.engine_base(multi_design,engines[1].id),4.15) and is_equal_approx(Craft.engine_base(multi_design,engines[1].id)+0.3285,0.0), "Two engine stack preserves attachment spacing and rests on the lower Titan nozzle")
	check(is_equal_approx(Parts.stats(multi_design).core_dry_mass, Parts.stats(lower_design).core_dry_mass + Parts.ENGINES.titan.mass), "Dry mass includes both engines")
	check(is_equal_approx(Parts.stats(multi_design).thrust, Parts.ENGINES.titan.thrust), "Launch thrust uses only the engine in the first stage")
	var multi_flight := Flight.new()
	multi_flight.reset(multi_design)
	multi_flight.execute_stage()
	check(multi_flight.state.active_engines == [engines[1].id] and is_equal_approx(multi_flight._active_propulsion().thrust,Parts.ENGINES.titan.thrust), "Lower engine ignites independently")
	var upper_fuel: float = multi_flight.state.engine_fuel.engine
	multi_flight.state.position = Vector3(0,1000,0)
	multi_flight.step(0.2,{"throttle":1.0})
	check(multi_flight.state.engine_fuel.engine == upper_fuel and multi_flight.state.engine_fuel[engines[1].id] < Parts.TANK_FUEL_MASS, "Lower engine burns its own fuel while upper tanks retain theirs")
	var lower_stage_mass_before := multi_flight._current_mass()
	multi_flight.execute_stage()
	check(engines[1].id in multi_flight.state.removed_parts and not multi_flight.state.engine_on and multi_flight._current_mass() < lower_stage_mass_before, "Interstage decoupler releases the lower engine and tank")
	multi_flight.execute_stage()
	check(multi_flight.state.active_engines == ["engine"] and is_equal_approx(multi_flight._active_propulsion().thrust,Parts.ENGINES.sparrow.thrust), "Upper engine ignites after lower stage separation")
	Craft.add_part(multistage,"decoupler",engines[1].id)
	Craft.add_part(multistage,"tank")
	Craft.add_part(multistage,"kestrel")
	check(Craft.valid(multistage) and Craft.engines(Craft.project(multistage, {})).size() == 3, "Engine-decoupler-tank-engine chain can be extended again")
	var shell_flight := Flight.new()
	shell_flight.reset(Craft.project(shrouded, Parts.default_design()))
	shell_flight.execute_stage()
	check(shell_flight.state.get("engine_shell_jettisoned", false) and not shell_flight.state.capsule_only, "Lower decoupler staging jettisons shell while retaining core")
	shell_flight.execute_stage()
	check(shell_flight.state.engine_on, "Core can ignite after shell separation")
	Craft.remove_part(shrouded, "engine")
	check(not shrouded.parts.any(func(part): return part.id == "engine_decoupler"), "Removing engine also removes its decoupler")
	var legacy := Parts.default_design()
	legacy.boosters = true
	legacy.booster_first = true
	var craft := Craft.migrate(legacy)
	check(Craft.valid(craft), "Legacy craft migrates to valid graph")
	var design := Craft.project(craft, legacy)
	check(design.tanks == 2 and design.boosters and design.booster_first, "Migration preserves design and ignition")
	check(craft.parts.any(func(part): return part.id == "separator"), "Legacy boosters receive separator hardware")
	check(Craft.descendant_ids(craft,"separator") == ["separator","boosters"], "Booster is a child of the separator")
	var old_combined := craft.duplicate(true)
	old_combined.parts = old_combined.parts.filter(func(part): return part.id != "separator")
	for part in old_combined.parts:
		if part.id == "boosters": part.parent = "tank_2"
	var upgraded := Craft.load_craft({"assembly":old_combined})
	check(Craft.valid(upgraded) and upgraded.stages == craft.stages, "Saved combined boosters upgrade without changing staging")
	var radial_removed := craft.duplicate(true)
	Craft.remove_part(radial_removed,"boosters")
	check(Craft.valid(radial_removed) and radial_removed.parts.any(func(part): return part.id == "separator"), "Removing boosters retains separators")
	Craft.add_part(radial_removed,"boosters")
	Craft.remove_part(radial_removed,"separator")
	check(Craft.valid(radial_removed) and not radial_removed.parts.any(func(part): return part.id in ["separator","boosters"]), "Removing separator removes booster descendants and actions")
	var no_engine := Craft.migrate(Parts.default_design())
	Craft.remove_part(no_engine,"engine")
	Craft.add_part(no_engine,"separator")
	Craft.add_part(no_engine,"boosters")
	check(no_engine.stages[0] == ["ignite:boosters"] and Craft.valid(no_engine), "Adding boosters before core engine creates a safe ignition stage")
	var original_ids: Array = craft.parts.map(func(part): return part.id)
	Craft.add_part(craft, "tank")
	check(Craft.valid(craft), "Adding a tank keeps a valid connected graph")
	for id in original_ids:
		check(craft.parts.any(func(part): return part.id == id), "Existing part identity survives adding a tank")
	var lower_subassembly := Craft.descendant_ids(craft, "tank_3")
	check("engine" in lower_subassembly and "boosters" in lower_subassembly, "Tank descendants identify the connected lower subassembly")
	Craft.remove_part(craft, "tank_3")
	check(Craft.valid(craft), "Removing a connected subassembly leaves a valid graph")
	check(not craft.parts.any(func(part): return part.id in lower_subassembly), "Removing a parent removes every connected descendant")
	craft = Craft.migrate(legacy)
	var corrupt := craft.duplicate(true)
	corrupt.parts[1].parent = "engine"
	check(not Craft.valid(corrupt), "Graph cycles rejected")
	corrupt = craft.duplicate(true)
	corrupt.stages[0].append("ignite:engine")
	check(not Craft.valid(corrupt), "Duplicate stage actions rejected")
	var flight := Flight.new()
	flight.reset(design)
	check(flight.execute_stage().contains("complete"), "First configured stage executes")
	check(not flight.state.engine_on and flight.state.boosters_on, "Only boosters ignite in first group")
	var fuel: float = flight.state.fuel
	flight.step(1.0, {"throttle": 1.0})
	check(flight.state.fuel == fuel, "Unlit core retains fuel")
	var mass_before: float = flight.state.mass
	flight.execute_stage()
	check(is_equal_approx(mass_before, flight.state.mass + flight.state.detached[0].mass + flight.state.detached[1].mass), "Booster separation conserves total mass")
	var debris_position: Vector3 = flight.state.detached[0].position
	flight.step(0.5, {"throttle": 1.0})
	check(flight.state.detached[0].position != debris_position, "Detached assembly retains motion")
	check(flight.state.engine_on and not flight.state.boosters_attached, "Grouped separation precedes core ignition")
	flight.execute_stage()
	check(flight.state.capsule_only, "Configured decoupler separates capsule")
	var index: int = flight.state.stage_index
	flight.state.position = Vector3(0, 10000, 0)
	flight.state.velocity = Vector3(0, 100, 0)
	flight.telemetry()
	var before := flight.state.duplicate(true)
	check(flight.execute_stage().contains("held"), "Unsafe chute stage held")
	check(flight.state == before and flight.state.stage_index == index, "Held stage has no side effects")
	flight.state.position = Vector3(0, 1000, 0)
	flight.state.velocity = Vector3(0, -50, 0)
	flight.telemetry()
	flight.execute_stage()
	check(flight.state.chute_deployed, "Safe chute stage deploys")
	check(flight.execute_stage() == "No stages remaining.", "Completed stage cannot execute twice")
	# An invalid grouped stage must not separate first and then reject ignition.
	craft.stages = [["ignite:engine", "ignite:boosters"], ["separate:decoupler", "separate:boosters"], ["deploy:capsule"]]
	design = Craft.project(craft, legacy)
	flight.reset(design)
	flight.execute_stage()
	flight._design.assembly.stages[1].append("ignite:engine")
	before = flight.state.duplicate(true)
	flight.execute_stage()
	check(flight.state == before, "Invalid grouped stage does not partly fire")
	# Complete a recovery using only stage actions, with no manual chute shortcut.
	design = Craft.project(Craft.migrate(Parts.default_design()), Parts.default_design())
	flight.reset(design)
	flight.execute_stage()
	var separated := false
	for frame in range(15000):
		var state := flight.telemetry()
		if state.max_altitude >= 1000 and not separated:
			flight.execute_stage()
			separated = true
		if state.chute_safe and not state.chute_deployed: flight.execute_stage()
		if state.status in ["landed", "crashed"]: break
		flight.step(0.1, {"throttle": 1.0})
	check(flight.state.status == "landed" and flight.state.stage_index == 3, "Configured three-stage rocket recovers safely")
	for failure in failures: push_error(failure)
	print("PASS: %d craft and stage checks." % count if failures.is_empty() else "FAIL: craft and stage checks")
	quit(0 if failures.is_empty() else 1)
