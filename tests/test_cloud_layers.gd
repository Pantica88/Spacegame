extends SceneTree
const Weather = preload("res://scripts/cloud_weather_map.gd")
const Editor = preload("res://scripts/planet_editor.gd")

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var weather := Weather.new()
	weather.initialize(64, 32)
	weather.image.fill(Color(0.6, 0, 0, 0))
	var base := weather.image.get_data()
	weather.ensure_layers()
	weather.add_paint_layer()
	var tile := Image.create(8, 8, false, Image.FORMAT_RGBA8)
	tile.fill(Color(0, 0, 0, 1))
	assert(weather.stamp_layer(Vector3.BACK, 0.5, tile, 1.0, 0.0, false, 0.2))
	assert(weather.paint_layers[0].image.get_data() == base)
	assert(weather.image.get_data() != base)
	var before := weather.layer_snapshot()
	assert(weather.stamp_layer(Vector3.BACK, 0.6, null, 1.0, 0.0, true, 0.1))
	assert(weather.paint_layers[0].image.get_data() == base, "Erase leaves the lower layer untouched")
	weather.paint_layers[1].visible = false
	weather.rebuild_layers()
	assert(weather.image.get_data() == base, "Hiding reveals the original lower layer")
	assert(not weather.stamp_layer(Vector3.BACK, 0.5, tile, 1.0, 0.0, false, 0.2))
	weather.paint_layers[1].visible = true
	weather.paint_layers[1].locked = true
	assert(not weather.replace_active_layer(tile), "Generation cannot replace locked paint")
	assert(before.paint_layers[1].image.get_data() != weather.paint_layers[1].image.get_data(), "Snapshots own their layer pixels")
	weather.paint_layers[1].name = "Storm details"
	assert(ResourceSaver.save(weather, "user://layer-test.res") == OK)
	var loaded: Resource = ResourceLoader.load("user://layer-test.res", "", ResourceLoader.CACHE_MODE_IGNORE_DEEP)
	assert(loaded.paint_layers.size() == 2)
	assert(loaded.active_layer == 1)
	assert(loaded.paint_layers[1].locked and loaded.paint_layers[1].name == "Storm details")
	assert(loaded.paint_layers[0].image.get_data() == base)
	var editor := Editor.new()
	root.add_child(editor)
	editor.settings.cloud_weather = before.layer_snapshot()
	editor._reset_cloud_history()
	editor._edit_cloud_layer("add")
	assert(editor.settings.cloud_weather.paint_layers.size() == 3)
	editor._generate_clouds(1234, 8, "cumulus")
	assert(editor.settings.cloud_weather.paint_layers[0].image.get_data() == base)
	assert(editor.settings.cloud_weather.paint_layers[1].image.get_data() == before.paint_layers[1].image.get_data())
	editor._undo_clouds()
	assert(editor.settings.cloud_weather.paint_layers[2].image.get_data().count(0) == 64 * 32 * 4)
	editor._undo_clouds()
	assert(editor.settings.cloud_weather.paint_layers.size() == 2)
	editor._redo_clouds()
	assert(editor.settings.cloud_weather.paint_layers.size() == 3)
	editor._edit_cloud_layer("locked", true)
	var locked: Resource = editor.settings.cloud_weather.layer_snapshot()
	editor._clear_clouds()
	assert(editor.settings.cloud_weather.image.get_data() == locked.image.get_data())
	editor._edit_cloud_layer("delete")
	assert(editor.settings.cloud_weather.paint_layers.size() == 3, "Locked layers cannot be deleted")
	editor._edit_cloud_layer("locked", false)
	editor._edit_cloud_layer("name", "Detail pass")
	editor._edit_cloud_layer("down")
	assert(editor.settings.cloud_weather.active_layer == 1)
	assert(editor.settings.cloud_weather.paint_layers[1].name == "Detail pass")
	editor._edit_cloud_layer("delete")
	assert(editor.settings.cloud_weather.paint_layers.size() == 2)
	editor._undo_clouds()
	assert(editor.settings.cloud_weather.paint_layers[1].name == "Detail pass")
	editor._procedural_clouds()
	assert(editor.settings.cloud_weather == null)
	editor._undo_clouds()
	assert(editor.settings.cloud_weather.paint_layers.size() == 3)
	editor.queue_free()
	await process_frame
	print("PASS: cloud layer isolation, visibility, locks, persistence, generation and history")
	quit()
